TELEGRAM_BOT_TOKEN=your-bot-token-from-the-botfather

# Webhook (leave empty for local dev — bot falls back to polling)
WEBHOOK_URL=
WEBHOOK_PORT=8443
WEBHOOK_PATH=/militarylaw/webhook
WEBHOOK_SECRET=  # generate: python3 -c "import secrets; print(secrets.token_hex(32))"

# Secret key for hashing user IDs in statistics (changing it resets user counts)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
STATS_SECRET_KEY=
